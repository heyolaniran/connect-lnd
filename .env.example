# .env

# --- Server Configuration ---
PORT=5003

# --- Single-node setup (legacy, node id defaults to "1") ---
# Use this OR the numbered _1/_2/_3 blocks below, not both for node 1.
# LND_NODE_ID=alice
# LND_GRPC_HOST=127.0.0.1:10009
# LND_MACAROON_BASE64=<base64-encoded macaroon string>
# LND_TLS_CERT_BASE64=<base64-encoded TLS certificate string>

# --- Multi-node setup (up to 3 nodes) ---
# Optional friendly id used in URLs: /api/nodes/alice/getinfo
LND_NODE_ID_1=alice
LND_GRPC_HOST_1=127.0.0.1:10009
LND_MACAROON_BASE64_1=<base64-encoded macaroon string>
LND_TLS_CERT_BASE64_1=<base64-encoded TLS certificate string>

# LND_NODE_ID_2=bob
# LND_GRPC_HOST_2=127.0.0.1:10010
# LND_MACAROON_BASE64_2=<base64-encoded macaroon string>
# LND_TLS_CERT_BASE64_2=<base64-encoded TLS certificate string>

# LND_NODE_ID_3=carol
# LND_GRPC_HOST_3=127.0.0.1:10011
# LND_MACAROON_BASE64_3=<base64-encoded macaroon string>
# LND_TLS_CERT_BASE64_3=<base64-encoded TLS certificate string>
